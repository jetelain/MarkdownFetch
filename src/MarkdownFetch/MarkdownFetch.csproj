<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <PackAsTool>true</PackAsTool>
	  <ToolCommandName>mdfetch</ToolCommandName>
	  <PackageId>Pmad.MarkdownFetch</PackageId>
	  <Version>0.0.1-preview</Version>
	  <Description>Small CLI to download any web resource as a markdown (with markitdown-api).</Description>
	  <Authors>Julien Etelain</Authors>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageProjectUrl>https://github.com/jetelain/MarkdownFetch</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/jetelain/MarkdownFetch</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageTags>markitdown</PackageTags>
	  <PublishAot>true</PublishAot>
  </PropertyGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="MimeMapping" Version="*" />
		<PackageReference Include="System.CommandLine" Version="2.0.13" />
	</ItemGroup>
</Project>
