<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Pmad.Markitdown</PackageId>
    <Version>0.1.0-preview</Version>
    <Description>Pure managed .NET library to convert HTML, PDF, and DOCX documents into clean Markdown.</Description>
    <Authors>Julien Etelain</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jetelain/MarkdownFetch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jetelain/MarkdownFetch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>markdown;converter;markitdown;html;pdf;docx</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="Mammoth" Version="1.13.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

</Project>
